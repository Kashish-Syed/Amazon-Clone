SKIP_PREFLIGHT_CHECK=true

# Firebase web config.
# Firebase console > Project settings > Your apps > SDK setup and configuration.
# None of these are secrets: the web config is public by design and ships in the
# client bundle. Firestore security rules are the real access control.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Stripe publishable key (pk_test_... / pk_live_...). Public by design.
# The matching SECRET key (sk_...) must never appear in this file or in src/ -
# it belongs only in the server-side function's secret store.
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Base URL of the payments API that creates Stripe PaymentIntents.
REACT_APP_PAYMENTS_API_URL=

# --- Optional: everything below has a sensible default ---

# Timeout for calls to the payments API, in milliseconds. Default 10000.
REACT_APP_PAYMENTS_TIMEOUT_MS=

# Minimum log level: debug | info | warn | error | silent.
# Defaults to debug in development and warn in production.
REACT_APP_LOG_LEVEL=

# How many recent log entries to keep in memory for __APP_LOGS__(). Default 200.
REACT_APP_LOG_BUFFER_SIZE=

# Feature flags. Each accepts "true"/"1" or "false"/"0" and defaults to enabled.
# Turning one off ships the capability dark rather than reverting the code.
REACT_APP_FEATURE_PROMOTIONS=
REACT_APP_FEATURE_TAX_ESTIMATES=
REACT_APP_FEATURE_EXPRESS_SHIPPING=
